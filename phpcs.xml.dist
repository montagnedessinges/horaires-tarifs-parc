<?xml version="1.0"?>
<ruleset name="Horaires Tarifs Parc">
    <description>Contrôles progressifs de compatibilité et de sécurité WordPress.</description>
    <file>horaires-tarifs-parc.php</file>
    <file>includes</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibility"/>
    <rule ref="PHPCompatibility.Extensions.RemovedExtensions.famRemoved">
        <exclude-pattern>includes/class-parcs-ht-admin-group-quotes-1177.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security"/>
    <!--
      Le contrôleur CSV valide explicitement nonce/capacité, extension, taille,
      is_uploaded_file(), parc, en-têtes et chaque champ après lecture. $_FILES
      ne doit pas être wp_unslash() ni assaini globalement avant ces contrôles.
    -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <exclude-pattern>includes/class-parcs-ht-faq-csv-1191.php</exclude-pattern>
    </rule>
</ruleset>
